; tox.ini — generated by `tomte scaffold tox` (library variant)
;
; Library / utility repos that don't ship `packages/` and don't need
; the autonomy bootstrap (currently: mech-client). The unit-test
; matrix is delegated to CI (GitHub Actions); tox is used only for
; lint envs targeting a single source tree.
;
; For agent repos (mech, trader, optimus, IEKit, mech-server,
; mech-interact, etc.), use `template_kind = "agent"` — see
; tox.ini.template.
;
; Substitution variables:
;   $$TOMTE_VERSION                 e.g. 0.7.0
;   $$LINT_TARGETS                  e.g. mech_client/
;   $$KNOWN_FIRST_PARTY             isort known_first_party
;   $$EXTRA_DEPS                    multi-line dep list (library-specific)
;   $$EXTRA_TESTENVS                multi-line; appended to file end
;   $$EXTRA_PYLINT_FLAGS            pre-rendered pylint extension CLI flags
;                                   (e.g. "--ignored-modules=web3 --disable=C0111"),
;                                   or empty when no extras declared

[tox]
envlist = bandit, safety, black, black-check, isort, isort-check, flake8, mypy, pylint, darglint, vulture, liccheck
skip_missing_interpreters = true
isolated_build = True
uv_seed = true

[testenv]
setenv =
    UV_PRERELEASE=allow

; -- linters --------------------------------------------------------------

[testenv:bandit]
skipsdist = True
skip_install = True
deps = tomte[bandit]$TOMTE_DEP_PIN
commands =
    bandit -c {envsitepackagesdir}/tomte/configs/bandit.yaml -r $LINT_TARGETS

[testenv:black]
skipsdist = True
skip_install = True
deps = tomte[black]$TOMTE_DEP_PIN
commands = black $LINT_TARGETS

[testenv:black-check]
skipsdist = True
skip_install = True
deps = tomte[black]$TOMTE_DEP_PIN
commands = black --check $LINT_TARGETS

[testenv:isort]
skipsdist = True
skip_install = True
deps = tomte[isort,cli]$TOMTE_DEP_PIN
commands_pre = tomte render-isort-config --output={envtmpdir}/isort.cfg --known-first-party=$KNOWN_FIRST_PARTY --known-local-folder=tests
commands = isort --gitignore --settings-path={envtmpdir}/isort.cfg $LINT_TARGETS

[testenv:isort-check]
skipsdist = True
skip_install = True
deps = tomte[isort,cli]$TOMTE_DEP_PIN
commands_pre = tomte render-isort-config --output={envtmpdir}/isort.cfg --known-first-party=$KNOWN_FIRST_PARTY --known-local-folder=tests
commands = isort --check-only --gitignore --settings-path={envtmpdir}/isort.cfg $LINT_TARGETS

[testenv:flake8]
skipsdist = True
skip_install = True
deps = tomte[flake8]$TOMTE_DEP_PIN
commands =
    flake8 --config={envsitepackagesdir}/tomte/configs/flake8.cfg \
        $LINT_TARGETS

[testenv:mypy]
skipsdist = True
skip_install = True
deps =
    pip
    tomte[mypy,cli]$TOMTE_DEP_PIN
$EXTRA_DEPS
commands_pre = tomte render-mypy-config --output={envtmpdir}/mypy.ini --append-from=tox.ini
commands = mypy --config-file={envtmpdir}/mypy.ini --disallow-untyped-defs $LINT_TARGETS

[testenv:pylint]
skipsdist = True
deps =
    tomte[pylint]$TOMTE_DEP_PIN
$EXTRA_DEPS
commands =
    pylint --rcfile={envsitepackagesdir}/tomte/configs/pylintrc $EXTRA_PYLINT_FLAGS \
        $LINT_TARGETS

[testenv:darglint]
; darglint has no --config-file flag; settings live in [darglint] at
; the bottom of this tox.ini.
skipsdist = True
skip_install = True
deps = tomte[darglint]$TOMTE_DEP_PIN
commands = darglint $LINT_TARGETS

[testenv:safety]
skipsdist = True
skip_install = True
deps = tomte[safety]$TOMTE_DEP_PIN
commands =
    safety check --policy-file {envsitepackagesdir}/tomte/configs/safety-policy.yml

[testenv:vulture]
skipsdist = True
skip_install = True
deps = tomte[vulture]$TOMTE_DEP_PIN
commands = vulture $LINT_TARGETS scripts/whitelist.py

[testenv:liccheck]
skipsdist = True
usedevelop = True
deps =
    pip
    tomte[liccheck,cli]$TOMTE_DEP_PIN
commands =
    tomte freeze-dependencies --output-path {envtmpdir}/requirements.txt
    liccheck -s tox.ini -r {envtmpdir}/requirements.txt -l PARANOID

$EXTRA_TESTENVS

; -- darglint: fleet-uniform settings (darglint has no --config-file flag) ---

[darglint]
docstring_style = sphinx
strictness = short
ignore_regex = async_act|.*_pb2\.py
ignore = DAR401

; -- repo-specific mypy overrides (rendered from [tomte-scaffold]) -----------
$EXTRA_MYPY_OVERRIDES

